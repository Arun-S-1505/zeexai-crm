# ============================================================
# ZEE X AI CRM Backend — Environment Variables
# Copy this file to .env and fill in real values
# NEVER commit .env to version control
# ============================================================

# Server
NODE_ENV=development
PORT=4000

# MongoDB Atlas (Dedicated Database)
MONGODB_URI=mongodb://user:password@cluster-shard-00-00.mongodb.net:27017,cluster-shard-00-01.mongodb.net:27017/zeexai_crm?ssl=true&replicaSet=atlas-shard-0&authSource=admin
MONGODB_DATABASE=zeexai_crm

# JWT Secrets — generate with: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=your_jwt_secret_64_characters_here
JWT_REFRESH_SECRET=your_jwt_refresh_secret_64_characters_here

# Access token expiry (e.g. 15m, 1h)
JWT_ACCESS_EXPIRES=15m
# Refresh token expiry in days
JWT_REFRESH_EXPIRES_DAYS=7

# CORS — URL of the CRM frontend (no trailing slash)
CLIENT_URL=http://localhost:3001

# Integration API Key — shared secret for server-to-server calls from main website
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
INTEGRATION_API_KEY=your_integration_api_key_here

